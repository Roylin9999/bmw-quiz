{
  // ===== 可修改設定 =====
  "name": "bmw-quiz",                 // 要和 Cloudflare 上的 Worker 名稱一致
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmw-quiz-db",                         // D1 資料庫名稱
      "database_id": "21451877-dcdc-4f7d-89f1-aaa881a2b8fb"   // D1 頁面上的 Database ID
    }
  ]
}
